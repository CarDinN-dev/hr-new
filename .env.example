MAIL_GRAPH_CERT_PATH=/run/secrets/mail_graph_private_key
MAIL_GRAPH_PRIVATE_KEY_FILE=
MICROSOFT_PROVISIONING_ENABLED=false
MICROSOFT_PROVISIONING_TENANT_ID=
MICROSOFT_PROVISIONING_CLIENT_ID=
MICROSOFT_PROVISIONING_CLIENT_SECRET=
MICROSOFT_ENTERPRISE_APP_OBJECT_ID=
MICROSOFT_USER_APP_ROLE_ID=
