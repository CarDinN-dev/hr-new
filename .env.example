JWT_SECRET=replace_with_64_or_more_random_characters
AUDIT_HMAC_KEY=replace_with_a_different_64_or_more_random_character_value
POSTGRES_PASSWORD=replace_with_a_strong_database_password
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=replace_with_a_strong_bootstrap_password
SEED_TEST_PERSONAS=false
CORS_ORIGIN=
LEAVE_EMAIL_ENABLED=false
MAIL_FROM=no-reply@med-tech.com
HR_ERP_URL=https://hr.example.com
MAIL_GRAPH_TENANT_ID=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CERT_THUMBPRINT=
